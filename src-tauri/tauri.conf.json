{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch",
  "version": "0.2.0",
  "identifier": "com.notch.app",
  "build": {
    "beforeDevCommand": "bun run --hot src/index.ts",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Notch",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "fileAssociations": [
      {
        "ext": ["notch"],
        "contentTypes": ["com.notch.library"],
        "name": "Notch Library",
        "description": "Notch Library",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-notch-library",
        "exportedType": {
          "identifier": "com.notch.library",
          "conformsTo": ["com.apple.package"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:notch.db"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/sb-/notch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQTlBRUEyRDI2M0IxMzEKUldReHNXUFNvcTZweldQVWNzekk4ZVlmNWd6OFZSOWYrelU2VUVYZFljcGEyWG0xbUdadEdTNXcK"
    }
  }
}
